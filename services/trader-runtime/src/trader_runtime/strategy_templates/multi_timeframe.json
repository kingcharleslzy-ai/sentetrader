{
  "id": "multi_timeframe",
  "name": "多周期共振",
  "category": "ma_trend",
  "scenario": "顺 15 分钟均线方向，在 5 分钟 RSI 走强 / 走弱时进场",
  "plainSummary": "先看 15 分钟图上的大方向（短均线在长均线上方算向上），再等小周期上的涨势明显变强时顺着大方向做多（反过来做空）；涨势退回中性或大方向变了就平仓。",
  "level": "进阶", "holding": "会隔夜",
  "source": {"label": "vn.py MultiTimeframeStrategy（15 分钟 MA5/20 定方向，5 分钟 RSI14 ±20）", "url": "https://github.com/vnpy/vnpy_ctastrategy/blob/main/vnpy_ctastrategy/strategies/multi_timeframe_strategy.py"},
  "recommendedTimeframe": 300,
  "approximations": [
    "原版以限价（收盘价 ± 5）挂单，这里下一根K线开盘价成交。",
    "原版没有止损；另设保护止损 3×ATR14（按品种波动自动缩放），RSI 回到 50 或大周期方向反转按收盘出场。"
  ],
  "params": [
    {"key": "fast", "label": "大方向短均线（15 分钟快线）", "default": 5, "min": 2, "max": 60, "step": 1, "unit": "根",
     "targets": ["rules.entryLong.conditions.0.left.period", "rules.entryShort.conditions.0.left.period",
                 "rules.exitLong.conditions.1.left.period", "rules.exitShort.conditions.1.left.period"],
     "help": {"what": "15 分钟图上短均线用最近多少根K线的平均价", "up": "大方向判断更慢、更稳", "down": "大方向转得更快，也更容易来回变"}},
    {"key": "slow", "label": "大方向长均线（15 分钟慢线）", "default": 20, "min": 3, "max": 200, "step": 1, "unit": "根",
     "targets": ["rules.entryLong.conditions.0.right.period", "rules.entryShort.conditions.0.right.period",
                 "rules.exitLong.conditions.1.right.period", "rules.exitShort.conditions.1.right.period"],
     "help": {"what": "15 分钟图上长均线用最近多少根K线的平均价；短均线在它上方算大方向向上", "up": "只认更长期的方向，信号更少", "down": "方向切换更频繁"}},
    {"key": "rsiPeriod", "label": "强弱参考根数（5 分钟 RSI 周期）", "default": 14, "min": 2, "max": 60, "step": 1, "unit": "根",
     "targets": ["rules.entryLong.conditions.1.left.period", "rules.entryShort.conditions.1.left.period",
                 "rules.exitLong.conditions.0.left.period", "rules.exitShort.conditions.0.left.period"],
     "help": {"what": "用最近多少根K线算涨跌强弱（RSI，0–100，50 是中性）", "up": "强弱读数更平稳，信号更少、更慢", "down": "读数更灵敏，信号更多也更杂"}},
    {"key": "rsiSignal", "label": "强弱门槛（RSI 偏离 50）", "default": 20, "min": 5, "max": 45, "step": 1, "unit": "点",
     "targets": [{"path": "rules.entryLong.conditions.1.right.value", "add": 50},
                 {"path": "rules.entryShort.conditions.1.right.value", "scale": -1, "add": 50}],
     "help": {"what": "大方向向上时强弱读数达到 50 加这个数才做多，向下时跌到 50 减这个数才做空", "up": "要更强的走势才进场，信号更少", "down": "稍有走强走弱就进场，信号更多"}},
    {"key": "stopAtr", "label": "保护止损（ATR 倍数）", "default": 3, "min": 0.5, "max": 10, "step": 0.5, "unit": "×ATR14", "targets": ["atrStop.multiple"],
     "help": {"what": "止损放得离开仓价多远，按最近波动大小自动换算", "up": "不容易被正常波动扫出场，但万一做错单笔亏得更多", "down": "亏损控制得紧，但容易被来回波动打掉"}},
    {"key": "maxPosition", "label": "每次手数", "default": 1, "min": 1, "max": 20, "step": 1, "unit": "手", "targets": ["maxPosition"],
     "help": {"what": "每次开仓下多少手", "up": "盈亏都按手数放大，占用的保证金也更多", "down": "盈亏都跟着缩小，更稳妥"}},
    {"key": "maxLoss", "label": "当日亏损上限", "default": null, "optional": true, "min": 100, "max": 1000000, "step": 100, "unit": "元", "targets": ["maxLoss"],
     "help": {"what": "留空就不设。填了以后，账户当天的净亏损（已平仓、浮动盈亏和手续费合计）达到这个数，这条策略不再开新仓，止损和离场照常", "up": "允许当天亏得更多才停手", "down": "更早停止开新仓，也可能错过当天后面的机会"}}
  ],
  "constraints": [{"less": ["fast", "slow"], "message": "快线周期须小于慢线周期"}],
  "plan": {
    "name": "多周期共振",
    "description": "15 分钟 MA{fast} 在 MA{slow} 上方时，5 分钟 RSI{rsiPeriod} 达到 50+{rsiSignal} 开多；MA{fast} 在 MA{slow} 下方时，RSI 跌到 50−{rsiSignal} 开空。多单在 RSI 跌回 50 以下或 15 分钟方向转空时平仓，空单对称。保护止损 {stopAtr}×ATR14。来源：vn.py MultiTimeframeStrategy。",
    "direction": "both", "timeframeSeconds": 300, "maxPosition": 1, "maxLoss": null,
    "stopLossTicks": 20, "takeProfitTicks": null, "cooldownBars": 0, "maxOrdersPerDay": 20,
    "atrStop": {"multiple": 3, "period": 14},
    "rules": {
      "entryLong": {"conditions": [
        {"label": "15 分钟 MA{fast} 在 MA{slow} 上方", "left": {"indicator": "ma", "period": 5, "timeframe": 900},
         "operator": "gt", "right": {"indicator": "ma", "period": 20, "timeframe": 900}},
        {"label": "5 分钟 RSI{rsiPeriod} 走强", "left": {"indicator": "rsi", "period": 14, "timeframe": 300},
         "operator": "gte", "right": {"indicator": "constant", "value": 70, "timeframe": 300}}]},
      "exitLong": {"join": "any", "conditions": [
        {"label": "RSI 跌回 50 以下", "left": {"indicator": "rsi", "period": 14, "timeframe": 300},
         "operator": "lt", "right": {"indicator": "constant", "value": 50, "timeframe": 300}},
        {"label": "15 分钟方向转空", "left": {"indicator": "ma", "period": 5, "timeframe": 900},
         "operator": "lte", "right": {"indicator": "ma", "period": 20, "timeframe": 900}}]},
      "entryShort": {"conditions": [
        {"label": "15 分钟 MA{fast} 在 MA{slow} 下方", "left": {"indicator": "ma", "period": 5, "timeframe": 900},
         "operator": "lt", "right": {"indicator": "ma", "period": 20, "timeframe": 900}},
        {"label": "5 分钟 RSI{rsiPeriod} 走弱", "left": {"indicator": "rsi", "period": 14, "timeframe": 300},
         "operator": "lte", "right": {"indicator": "constant", "value": 30, "timeframe": 300}}]},
      "exitShort": {"join": "any", "conditions": [
        {"label": "RSI 升回 50 以上", "left": {"indicator": "rsi", "period": 14, "timeframe": 300},
         "operator": "gt", "right": {"indicator": "constant", "value": 50, "timeframe": 300}},
        {"label": "15 分钟方向转多", "left": {"indicator": "ma", "period": 5, "timeframe": 900},
         "operator": "gte", "right": {"indicator": "ma", "period": 20, "timeframe": 900}}]}
    }
  }
}
