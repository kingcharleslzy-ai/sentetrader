AI_TRADER_OWNER_USERNAME=
# 初始管理员密码。管理员在设置 → 账户改过密码后以 Runtime 库表 owner_password 为准（2026-10-21）；
# 忘了改过的密码时删掉该表那一行，即恢复用这里的密码登录。
AI_TRADER_OWNER_PASSWORD_HASH_FILE=/opt/ai-trader/secrets/owner-password-hash
AI_TRADER_OWNER_SESSION_SECRET_FILE=/opt/ai-trader/secrets/owner-session-secret
AI_TRADER_OWNER_PROFILE_ID=owner-default
AI_TRADER_ALLOWED_ORIGINS=https://qilinshuzhi.com,tauri://localhost,http://tauri.localhost,https://tauri.localhost
AI_TRADER_RUNTIME_PORT=18000
AI_TRADER_RUNTIME_GREEN_PORT=18001
AI_TRADER_BUILD_SHA=
AI_TRADER_AGENT_MODE=native
AI_TRADER_AGENT_PROVIDER=proxyapi
AI_TRADER_AGENT_MODEL=gpt-6-astra
AI_TRADER_AGENT_REASONING_EFFORT=low
# 多 AI 研讨三方模型（留空用默认：多方 deepseek-flash、空方 glm-5.3-flash、裁判 deepseek-flash）。
# AI_TRADER_DEBATE_BULL_MODEL=
# AI_TRADER_DEBATE_BEAR_MODEL=
# AI_TRADER_DEBATE_JUDGE_MODEL=
# 空方模型不可用（限流/认证/超时/上游 5xx）时换的兜底，留空用 deepseek-flash；裁判的兜底 AI_TRADER_DEBATE_JUDGE_FALLBACK 留空用 k3.1-pro，需要下面的 Kimi 密钥文件。
# AI_TRADER_DEBATE_BEAR_FALLBACK=
# Kimi K3 密钥（仅平台内部用于研讨兜底，不出现在用户的模型菜单）。默认走 Kimi Code 端点
# https://api.kimi.com/coding/v1、模型名 k3；改用 Moonshot 开放平台密钥时再设下面两项。
# AI_TRADER_MOONSHOT_API_KEY_FILE=/opt/ai-trader/secrets/moonshot-api-key
# AI_TRADER_KIMI_BASE_URL=https://api.moonshot.cn/v1
# AI_TRADER_KIMI_MODEL=kimi-k3
# Public read-only browsing remains off until the market-data source is approved for guests.
# 回测并发（可选，空值或非法值回退默认，不会变 0）：规则回测与 AI 官方回测各自同时运行的上限
# （全局 / 每人），规则回测排队等待秒数（超时 429），规则回测常驻计算进程数（默认等于全局并发）。
# AI_TRADER_BACKTEST_GLOBAL_LIMIT=2
# AI_TRADER_BACKTEST_USER_LIMIT=1
# AI_TRADER_BACKTEST_QUEUE_WAIT_SECONDS=60
# AI_TRADER_BACKTEST_WORKERS=
# AI_TRADER_BACKTEST_GLOBAL_QUEUE_LIMIT=32
# AI_TRADER_BACKTEST_USER_QUEUE_LIMIT=4
# AI_TRADER_BACKTEST_TIMEOUT_SECONDS=30
# 语音前台直接查询（可选）：空=关；all=全部用户；或逗号分隔的 user_id（先只开测试账号）。
# AI_TRADER_VOICE_FRONT_QUERY=
# 语音前台下单类直接出卡（可选，只在前台直接查询也开着的账号生效）：同样的写法，先只开测试账号。
# AI_TRADER_VOICE_FRONT_ACTION=
AI_TRADER_GUEST_ENABLED=0
# Existing pool account ID selected for public quotes; never falls back to the owner account.
AI_TRADER_GUEST_MARKET_ACCOUNT_ID=
# 游客与普通用户共用的页面行情源；新名称优先，兼容上面的旧配置。
AI_TRADER_SHARED_MARKET_ACCOUNT_ID=
# 多账号接力 (2026-10-04)：逗号分隔的有序行情源清单；首次启动播种进库，之后以库为准
# （管理员 PUT /api/admin/market-sources 在线维护）。留空时回落上面的单账号配置。
AI_TRADER_SHARED_MARKET_ACCOUNT_IDS=
AI_TRADER_PROXYAPI_BASE_URL=https://ai-runtime.qilinshuzhi.com:8443/internal-model/v1
AI_TRADER_MODEL_API_KEY_FILE=/opt/ai-trader/secrets/model-api-key
AI_TRADER_READONLY_SIDECAR_TOKEN_FILE=/opt/ai-trader/secrets/tqkq-sidecar-token
AI_TRADER_TQKQ_USERNAME_FILE=/opt/ai-trader/secrets/tqkq-username
AI_TRADER_TQKQ_PASSWORD_FILE=/opt/ai-trader/secrets/tqkq-password
AI_TRADER_TQKQ_SYMBOLS=SHFE.au2612,SHFE.rb2610
# 第二个交易账户（可选覆盖层 docker-compose.accounts.yml；缺省即单账户，行为不变）。
# 启用步骤见 docs/THREE_PLATFORM_AND_WEB_DEPLOYMENT.md「启用第二个模拟账户」。
# AI_TRADER_ACCOUNTS_OVERLAY=1
# AI_TRADER_ACCOUNTS_FILE_HOST=/opt/ai-trader/config/accounts.json
# AI_TRADER_READONLY_SIDECAR_TOKEN_2_FILE=/opt/ai-trader/secrets/tqkq-sidecar-token-2
# AI_TRADER_TQKQ_USERNAME_2_FILE=/opt/ai-trader/secrets/tqkq-username-2
# AI_TRADER_TQKQ_PASSWORD_2_FILE=/opt/ai-trader/secrets/tqkq-password-2
# 后台「服务器」：运维台 metrics 只读令牌文件（主机路径；不设则该页显示未配置）
AI_TRADER_INFRA_CONSOLE_TOKEN_FILE=
# 锁屏推送：VAPID 私钥文件（主机路径，PEM / P-256，属主 999:999、权限 0400；不设则锁屏提醒显示“服务器还没开通”）
AI_TRADER_WEBPUSH_VAPID_PRIVATE_KEY_FILE=
