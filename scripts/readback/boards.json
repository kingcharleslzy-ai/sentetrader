{
  "about": "看板 · 铺满版（11-05）：顶栏看板进“盘中”（默认摆法铺满，每块按自己的大小选档）；下拉里有“新建空白看板”和这套看板的编辑、改名、删除；新建“回读看板”后进入编辑、开模块库，按“放在哪块的哪一边 / 比例”一块块放满七个模块，调比例、锁档、拿掉再撤销，再放一块图表（1 小时、再改成日线）后拿掉，图表换成紫色联动，让 AI 帮我摆一套复盘（真走模型，看到预览），用这套再撤销，打开一块的 ⋯，完成后小档下单露出买多 / 卖空（点了先弹确认，回读不点）。回读窗口固定 1440×900（工具只有这一种电脑尺寸），1280×800 和 2560×1440 在浏览器里另看。只改测试账号自己的看板偏好，最后回到“盘中”、删掉“回读看板”、回交易台。",
  "steps": [
    {"ui": {"view": "trade"}, "expect": {"view": "trade"}},
    {"ui": {"view": "dashboard"}, "expect": {"view": "dashboard", "preferences.ui.boards.current": {"exists": true}}},
    {"ui": {"boards": {"select": "live"}}, "expect": {"view": "dashboard", "preferences.ui.boards.current": "live", "boards.tiles": {"includes": "\"chart\""}}},
    {"screenshot": "21-live-board"},
    {"ui": {"disclosure": {"name": "boards-menu", "open": true}}, "expect": {"observation.controls": {"includes": "删除这套看板"}}},
    {"screenshot": "22-boards-menu"},
    {"ui": {"disclosure": {"name": "boards-menu", "open": false}}},
    {"ui": {"boards": {"create": "回读看板"}}, "expect": {"preferences.ui.boards.items": {"includes": "回读看板"}}},
    {"api": "GET /api/preferences", "expect": {"body.preferences.ui.boards.current": {"exists": true}}, "save": {"boardId": "body.preferences.ui.boards.current"}},
    {"ui": {"boards": {"editing": true}}, "expect": {"boards.editing": true}},
    {"ui": {"disclosure": {"name": "board-library", "open": true}}, "expect": {"boards.library": true, "observation.controls": {"includes": "把图表放进看板"}}},
    {"screenshot": "23-blank-editing"},
    {"ui": {"boards": {"place": {"module": "chart"}}}, "expect": {"boards.tiles": {"includes": "\"chart\""}}},
    {"ui": {"boards": {"place": {"module": "sheet", "target": "chart", "side": "right", "ratio": 0.4}}}, "expect": {"boards.tiles": {"includes": "\"sheet\""}}},
    {"ui": {"boards": {"place": {"module": "positions", "target": "chart", "side": "bottom", "ratio": 0.3}}}, "expect": {"boards.tiles": {"includes": "\"positions\""}}},
    {"ui": {"boards": {"place": {"module": "order", "target": "sheet", "side": "bottom"}}}, "expect": {"boards.tiles": {"includes": "\"order\""}}},
    {"ui": {"boards": {"place": {"module": "alert", "target": "order", "side": "right"}}}, "expect": {"boards.tiles": {"includes": "\"alert\""}}},
    {"ui": {"boards": {"place": {"module": "chat", "target": "positions", "side": "right"}}}, "expect": {"boards.tiles": {"includes": "\"chat\""}}},
    {"ui": {"boards": {"place": {"module": "watch", "side": "right", "ratio": 0.25}}}, "expect": {"boards.tiles": {"includes": "\"watch\""}}},
    {"ui": {"boards": {"ratio": {"module": "chart", "value": 0.6}}}},
    {"ui": {"boards": {"lock": {"module": "watch", "size": "small"}}}, "expect": {"boards.tiles": {"includes": "\"locked\":\"small\""}}},
    {"ui": {"boards": {"take": "alert"}}},
    {"ui": {"boards": {"undo": true}}, "expect": {"boards.tiles": {"includes": "\"alert\""}}},
    {"ui": {"disclosure": {"name": "board-library", "open": false}}},
    {"ui": {"boards": {"place": {"module": "chart", "target": "chart", "side": "right", "duration": 3600}}}, "expect": {"boards.tiles": {"includes": "\"chart-2\""}}},
    {"ui": {"boards": {"chart": {"block": "chart-2", "duration": 86400}}}, "expect": {"boards.tiles": {"includes": "\"duration\":86400"}}},
    {"screenshot": "23a-two-charts"},
    {"ui": {"boards": {"take": "chart-2"}}},
    {"ui": {"boards": {"link": {"module": "chart", "color": "purple"}}}, "expect": {"boards.tiles": {"includes": "\"link\":\"purple\""}}},
    {"ui": {"boards": {"ask": "摆一套复盘，持仓和对话为主"}}, "expect": {"boards.preview": {"includes": "blocks"}}, "timeoutMs": 60000},
    {"screenshot": "24a-ai-preview"},
    {"ui": {"boards": {"adopt": true}}, "expect": {"boards.preview": null}},
    {"ui": {"boards": {"undo": true}}, "expect": {"boards.tiles": {"includes": "\"alert\""}}},
    {"ui": {"disclosure": {"name": "board-tile-menu", "id": "chart", "open": true}}, "expect": {"observation.controls": {"includes": "拿掉（旁边的补满）"}}},
    {"screenshot": "24-filled-editing"},
    {"ui": {"disclosure": {"name": "board-tile-menu", "id": "chart", "open": false}}},
    {"ui": {"boards": {"editing": false}}, "expect": {"boards.editing": false, "observation.controls": {"includes": "买多"}}},
    {"screenshot": "25-filled"},
    {"api": "GET /api/preferences", "expect": {"body.preferences.ui.boards.items": {"includes": "\"splitPercentages\""}}}
  ],
  "cleanup": [
    {"ui": {"boards": {"select": "live"}}, "expect": {"preferences.ui.boards.current": "live"}},
    {"ui": {"boards": {"remove": "{{boardId}}"}}, "expect": {"preferences.ui.boards.current": "live"}},
    {"ui": {"view": "trade"}, "expect": {"view": "trade"}}
  ]
}
