{
  "about": "第 5 批（今日作战表）：用测试账号现有的自选（至少两个品种，没有就停下），建一个“验收开盘突破”打法，作战表接口与调研面板第一页都排出自选里的品种；再看品种调研的今日判断不写偏多偏空和信心。结束后只删掉这个打法，不改自选。",
  "steps": [
    {"api": "GET /api/preferences", "expect": {"body.preferences.watchlist.products.1": {"exists": true}}},
    {"api": "POST /api/playbooks", "status": 201, "body": {"name": "验收开盘突破", "entryRules": "突破开盘区间高点再进", "exitRules": "", "stopRules": ""},
     "save": {"playbookId": "body.playbook.id"}},
    {"api": "GET /api/research/sheet", "expect": {"body.rows.1.product": {"exists": true}, "body.rows.0.priority": {"exists": true},
     "body.rows.0.levels.0.label": {"exists": true}, "body.rows.0.stance": {"exists": false}, "body.playbookCount": 1}},
    {"ui": {"panel": "news"}, "expect": {"panel": "news"}},
    {"ui": {"news": {"tab": "sheet"}}, "expect": {"news.tab": "sheet", "news.sheet.status": "ready",
     "observation.text": {"includes": "今日作战表"}}},
    {"screenshot": "01-sheet"},
    {"ui": {"news": {"tab": "desk"}}, "expect": {"news.tab": "desk", "news.desk.status": "ready"}},
    {"screenshot": "02-desk"},
    {"ui": {"panel": null}, "expect": {"panel": null}}
  ],
  "cleanup": [
    {"api": "DELETE /api/playbooks/{{playbookId}}"}
  ]
}
